# Secrets: never bake env files into the image (Dockerfile does COPY . .)
.env
.env.*
**/.env
**/.env.*
**/.env.example

# Virtualenvs and Python caches
.venv/
venv/
**/__pycache__/
**/*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Git metadata and CI config
.git/
.github/

# Local crawl output and caches (never shipped)
output/
**/*.log
**/*.jl
.scrapy/
.scrapy_cache/
**/.scrapy_cache/
