# Copy to .env and fill real values. Never commit .env (git-ignored).
# Single source of truth: ../job-platform-infra/envs/.env.dev.example

# PostgreSQL for crawled_jobs table (CRAWL-01-04)
DATABASE_URL_CRAWLER=postgresql://postgres:postgres@localhost:5432/job_platform_crawler

# Elasticsearch for jobs index sync (CRAWL-01-05)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=jobs

# Crawl limits (CRAWL-01-01): 10 = dev (~100 jobs), 100 = full (~1000 jobs)
MAX_PAGES=10

# Items per API page_num request
PAGE_SIZE=20

# Job group filter, mirrors ?nhom_tin_tuyen_dung= on /search/ (empty = all)
NHOM_TIN_TUYEN_DUNG=4

# Target site (HTML fallback routes) + public JSON API base (verified 2026-09-08)
CRAWLER_TARGET=https://vieclam.gov.vn
CRAWLER_API_BASE=https://api.vieclam.gov.vn/webhook

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Scrapy environment: development | production (HTTPCACHE only in development)
SCRAPY_ENV=development
